<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <!--
            A bare FragmentActivity for the biometric prompt host test.

            androidx.biometric hosts its prompt in the activity's fragment manager, so the only way
            to assert that supplying a host changes anything is to supply a real one. This activity
            exists solely for that and ships in the instrumented test APK, never in the app.
        -->
        <activity
                android:name="id.andriawan.cofinance.data.lock.BiometricHostTestActivity"
                android:exported="false" />

    </application>

</manifest>
