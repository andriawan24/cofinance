    <!-- Penyiapan enkripsi -->
    <string name="title_encryption_setup">Siapkan enkripsi</string>
    <string name="description_encryption_setup">Cofinance mengenkripsi akun dan transaksi Anda di perangkat ini sebelum disinkronkan. Salinan yang tersimpan di cloud tidak dapat dibaca tanpa kunci yang ada di perangkat Anda.</string>
    <string name="title_recovery_phrase">Frasa pemulihan Anda</string>
    <string name="description_recovery_phrase">Tulis 12 kata ini di kertas, sesuai urutannya, lalu simpan di tempat yang aman.</string>
    <string name="warning_recovery_phrase_loss">Jika Anda kehilangan 12 kata ini dan kehilangan perangkat ini, akun dan transaksi yang sudah tersinkronisasi akan hilang selamanya. Tidak ada seorang pun yang dapat mengembalikannya — baik kami maupun pihak lain. Tidak ada pengaturan ulang dan tidak ada kode cadangan.</string>
    <string name="note_local_data_not_encrypted">Ini tidak mengenkripsi salinan yang tersimpan di ponsel ini. Yang dilindungi adalah salinan yang disinkronkan ke cloud.</string>
    <string name="action_written_it_down">Saya sudah menuliskannya</string>
    <string name="title_confirm_recovery_phrase">Konfirmasi frasa Anda</string>
    <string name="description_confirm_recovery_phrase">Ketik kata-kata berikut dari catatan yang Anda tulis. Penyiapan belum selesai, dan belum ada data yang disinkronkan, sampai kata-katanya cocok.</string>
    <string name="label_recovery_phrase_word">Kata ke-%1$d</string>
    <string name="action_back_to_phrase">Tampilkan kata-katanya lagi</string>
    <string name="action_confirm_recovery_phrase">Selesaikan penyiapan</string>
    <string name="error_recovery_phrase_confirmation">Kata-kata tersebut tidak cocok dengan frasa Anda. Periksa catatan Anda lalu coba lagi.</string>
    <string name="error_encryption_setup_failed">Penyiapan enkripsi tidak dapat diselesaikan, sehingga belum ada data yang disinkronkan. Silakan coba lagi.</string>

    <!-- Pemulihan dengan frasa -->
    <string name="title_restore_data">Pulihkan data Anda</string>
